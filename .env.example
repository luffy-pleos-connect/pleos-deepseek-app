# MOCA 서버 환경변수 예시. 실제 값은 .env 에 넣고 커밋하지 않는다.
# 실행: node --env-file=.env local.mjs
PORT=8787
HOST=127.0.0.1
MOCA_DB=moca.sqlite

# Hive (OpenAI 호환)
HIVE_API_URL=https://api-cdn.thehive.ai/api/v3/chat/completions
HIVE_MODEL=deepseek-ai/deepseek-v4.1-flash-1017
HIVE_API_KEY=

# 하루 전체 /chat 상한
DAILY_CHAT_LIMIT=500
HIVE_TIMEOUT_MS=20000

# Vercel 배포 시 (Upstash REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
