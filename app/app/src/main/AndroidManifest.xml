<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 읽기 전용 차량 데이터 권한만. 제어 권한은 넣지 않는다.
         getTelltalesInfo/registerTelltales 는 공식 문서상 PRIVATE_CAR_SAFETY(signature|privileged)이나,
         Pleos 에뮬레이터 2.1.0에서는 protectionLevel=normal 로 선언되어 있다(G0 실측).
         실차에서 막히면 이 기능은 "연동 코드 구현, 실값 미확인"으로 표기한다. -->
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />

    <!-- NaviHelper: 경로·검색은 S1, 검색 화면은 requestNavigationScreen (NAVI_CUSTOM_MAP). -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />

    <!-- 보이스: 음성 인식. 주행 중에는 PleosUxRestrictions 로 진입을 막는다. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 서버(/chat·/snapshots·/opponent) 통신. HTTPS 는 release, HTTP 는 디버그 전용 설정. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 시동 때 화면 없이 한 번 점검하고 바로 끝낸다. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".MocaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PleosConnect">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- 주행 중에도 표시. 제한 항목은 PleosUxRestrictions 로 처리한다. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".inspect.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".inspect.InspectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
