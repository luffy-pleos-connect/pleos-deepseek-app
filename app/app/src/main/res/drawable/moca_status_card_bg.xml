<?xml version="1.0" encoding="utf-8"?>
<!-- 구역 카드 배경. 펼친 카드는 테두리만 진하게 해 표시한다(hex 금지, DS 토큰만). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pleos_surface_basic" />
            <corners android:radius="@dimen/pleos_notification_radius" />
            <stroke android:width="@dimen/pleos_text_field_border" android:color="@color/pleos_text_dark_tertiary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pleos_surface_basic" />
            <corners android:radius="@dimen/pleos_notification_radius" />
            <stroke android:width="@dimen/pleos_text_field_border" android:color="@color/pleos_alpha_dark_100" />
        </shape>
    </item>
</selector>
