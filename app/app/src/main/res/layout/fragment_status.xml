<?xml version="1.0" encoding="utf-8"?>
<!--
  상태관리 (최종정리 5장). 왼쪽은 등급·관리 점수·2D 그림·[다시 점검]·추이, 오른쪽은 구역 카드 5개.
  오른쪽만 스크롤한다. 왼쪽은 1680×1210 패널에 스크롤 없이 들어간다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="@dimen/moca_screen_margin"
    android:paddingTop="@dimen/moca_gap"
    android:paddingEnd="@dimen/moca_screen_margin"
    android:paddingBottom="@dimen/moca_gap">

    <!-- 왼쪽: 등급 · 관리 · 그림 · 다시 점검 · ABS 해결 · 추이 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/statusGrade"
                style="@style/Pleos.Text.Title.L"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_grade_placeholder" />

            <TextView
                android:id="@+id/statusCare"
                style="@style/Pleos.Text.Body.L"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/moca_gap"
                android:layout_weight="1"
                android:textColor="@color/pleos_text_dark_secondary" />
        </LinearLayout>

        <ai.moca.app.ui.widget.CarDiagramView
            android:id="@+id/carDiagram"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/moca_gap_small"
            android:layout_weight="1" />

        <Button
            android:id="@+id/buttonReinspect"
            style="@style/Widget.Pleos.Button.Secondary.L"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap"
            android:text="@string/status_reinspect" />

        <Button
            android:id="@+id/buttonResolveAbs"
            style="@style/Widget.Pleos.Button.Primary.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap_small"
            android:text="@string/status_resolve_abs"
            android:visibility="gone" />

        <TextView
            style="@style/Pleos.Text.Title.S"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap"
            android:text="@string/status_trend_title" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/moca_trend_height"
            android:layout_marginTop="@dimen/moca_gap_small">

            <ai.moca.app.ui.widget.TrendGraphView
                android:id="@+id/trendGraph"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/trendEmpty"
                style="@style/Pleos.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/status_trend_empty"
                android:textColor="@color/pleos_text_dark_secondary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- 오른쪽: 구역 카드 5개. 카드를 누르면 그 카드만 펼쳐진다. -->
    <ScrollView
        android:id="@+id/statusCardsScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/moca_gap"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/statusCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
