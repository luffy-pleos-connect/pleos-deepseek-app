<?xml version="1.0" encoding="utf-8"?>
<!--
  월간랭킹 (최종정리 7장·12장). 위: 「N월 월간랭킹」· [대전하기로].
  왼쪽: 내 순위 한 줄과 순위표(이 목록만 스크롤). 오른쪽: 이번 달 내 관리 요약 · AI 한 줄 · [질문하기].
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/moca_screen_margin"
    android:paddingTop="@dimen/moca_gap"
    android:paddingEnd="@dimen/moca_screen_margin"
    android:paddingBottom="@dimen/moca_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rankingTitle"
            style="@style/Pleos.Text.Title.L"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/rankingBack"
            style="@style/Widget.Pleos.Button.Primary.M"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ranking_back" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/moca_gap"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- 왼쪽: 순위표 -->
        <LinearLayout
            style="@style/Widget.Pleos.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/moca_card_padding">

            <TextView
                android:id="@+id/rankingMine"
                style="@style/Pleos.Text.Title.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/pleos_text_dark_primary" />

            <ScrollView
                android:id="@+id/rankingScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/moca_gap_small"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rankingList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/rankingEmpty"
                style="@style/Pleos.Text.Body.L"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/c20_not_enough_data"
                android:textColor="@color/pleos_text_dark_secondary"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 오른쪽: 이번 달 내 관리 요약 -->
        <LinearLayout
            style="@style/Widget.Pleos.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/moca_gap"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/moca_card_padding">

            <TextView
                style="@style/Pleos.Text.Title.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ranking_care_title" />

            <LinearLayout
                android:id="@+id/rankingCareLines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/rankingAiText"
                style="@style/Pleos.Text.Body.L"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap"
                android:textColor="@color/pleos_text_dark_secondary" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/rankingAsk"
                style="@style/Widget.Pleos.Button.Secondary.L"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap"
                android:text="@string/ranking_ask" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
