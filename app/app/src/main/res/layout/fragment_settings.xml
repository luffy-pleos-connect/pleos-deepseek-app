<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/moca_screen_margin"
    android:paddingTop="@dimen/moca_gap"
    android:paddingEnd="@dimen/moca_screen_margin"
    android:paddingBottom="@dimen/moca_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/Widget.Pleos.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/moca_card_padding"
            android:paddingTop="@dimen/moca_gap_small"
            android:paddingEnd="@dimen/moca_card_padding"
            android:paddingBottom="@dimen/moca_gap_small">

            <TextView
                style="@style/Pleos.Text.Label.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/pleos_text_dark_tertiary" />

            <LinearLayout
                android:id="@+id/settingsGroupProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap_small"
                android:layout_weight="1"
                android:background="@drawable/moca_row_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/moca_status_row_min"
                android:orientation="horizontal"
                android:paddingStart="@dimen/moca_gap_small"
                android:paddingEnd="@dimen/moca_gap_small">

                <TextView
                    style="@style/Pleos.Text.Title.S"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_group_profile" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsGroupDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/moca_row_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/moca_status_row_min"
                android:orientation="horizontal"
                android:paddingStart="@dimen/moca_gap_small"
                android:paddingEnd="@dimen/moca_gap_small">

                <TextView
                    style="@style/Pleos.Text.Title.S"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_group_demo" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsGroupData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/moca_row_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/moca_status_row_min"
                android:orientation="horizontal"
                android:paddingStart="@dimen/moca_gap_small"
                android:paddingEnd="@dimen/moca_gap_small">

                <TextView
                    style="@style/Pleos.Text.Title.S"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_group_data" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Pleos.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/moca_gap"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/moca_card_padding">

            <LinearLayout
                android:id="@+id/settingsPanelProfile"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Pleos.Text.Label.M"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_nickname"
                    android:textColor="@color/pleos_text_dark_tertiary" />

                <TextView
                    android:id="@+id/nicknameValue"
                    style="@style/Pleos.Text.Title.L"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/moca_gap_small"
                    android:text="@string/home_grade_placeholder" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsPanelDemo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <Switch
                    android:id="@+id/switchDemo"
                    style="@style/Widget.Pleos.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_demo" />

                <TextView
                    style="@style/Pleos.Text.Body.M"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/moca_gap_small"
                    android:text="@string/settings_demo_help"
                    android:textColor="@color/pleos_text_dark_secondary" />

                <LinearLayout
                    android:id="@+id/scenarioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/moca_gap"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <ToggleButton
                            android:id="@+id/scenarioD0"
                            style="@style/Widget.Pleos.ToggleButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:checked="false"
                            android:background="@drawable/moca_scenario_bg"
                            android:ellipsize="none"
                            android:maxLines="2"
                            android:minHeight="@dimen/pleos_toggle_button_height"
                            android:paddingStart="@dimen/moca_gap_small"
                            android:paddingEnd="@dimen/moca_gap_small"
                            android:textAppearance="@style/Pleos.Text.Label.S"
                            android:textColor="@color/moca_scenario_text"
                            android:textSize="@dimen/pleos_text_label_s"
                            android:textOff="@string/settings_scenario_d0"
                            android:textOn="@string/settings_scenario_d0" />

                        <ToggleButton
                            android:id="@+id/scenarioD1"
                            style="@style/Widget.Pleos.ToggleButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/moca_gap"
                            android:layout_weight="1"
                            android:checked="false"
                            android:background="@drawable/moca_scenario_bg"
                            android:ellipsize="none"
                            android:maxLines="2"
                            android:minHeight="@dimen/pleos_toggle_button_height"
                            android:paddingStart="@dimen/moca_gap_small"
                            android:paddingEnd="@dimen/moca_gap_small"
                            android:textAppearance="@style/Pleos.Text.Label.S"
                            android:textColor="@color/moca_scenario_text"
                            android:textSize="@dimen/pleos_text_label_s"
                            android:textOff="@string/settings_scenario_d1"
                            android:textOn="@string/settings_scenario_d1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/moca_gap_small"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <ToggleButton
                            android:id="@+id/scenarioD2"
                            style="@style/Widget.Pleos.ToggleButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:checked="false"
                            android:background="@drawable/moca_scenario_bg"
                            android:ellipsize="none"
                            android:maxLines="2"
                            android:minHeight="@dimen/pleos_toggle_button_height"
                            android:paddingStart="@dimen/moca_gap_small"
                            android:paddingEnd="@dimen/moca_gap_small"
                            android:textAppearance="@style/Pleos.Text.Label.S"
                            android:textColor="@color/moca_scenario_text"
                            android:textSize="@dimen/pleos_text_label_s"
                            android:textOff="@string/settings_scenario_d2"
                            android:textOn="@string/settings_scenario_d2" />

                        <ToggleButton
                            android:id="@+id/scenarioD3"
                            style="@style/Widget.Pleos.ToggleButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/moca_gap"
                            android:layout_weight="1"
                            android:checked="true"
                            android:background="@drawable/moca_scenario_bg"
                            android:ellipsize="none"
                            android:maxLines="2"
                            android:minHeight="@dimen/pleos_toggle_button_height"
                            android:paddingStart="@dimen/moca_gap_small"
                            android:paddingEnd="@dimen/moca_gap_small"
                            android:textAppearance="@style/Pleos.Text.Label.S"
                            android:textColor="@color/moca_scenario_text"
                            android:textSize="@dimen/pleos_text_label_s"
                            android:textOff="@string/settings_scenario_d3"
                            android:textOn="@string/settings_scenario_d3" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/moca_gap_small"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <ToggleButton
                            android:id="@+id/scenarioD4"
                            style="@style/Widget.Pleos.ToggleButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:checked="false"
                            android:background="@drawable/moca_scenario_bg"
                            android:ellipsize="none"
                            android:maxLines="2"
                            android:minHeight="@dimen/pleos_toggle_button_height"
                            android:paddingStart="@dimen/moca_gap_small"
                            android:paddingEnd="@dimen/moca_gap_small"
                            android:textAppearance="@style/Pleos.Text.Label.S"
                            android:textColor="@color/moca_scenario_text"
                            android:textSize="@dimen/pleos_text_label_s"
                            android:textOff="@string/settings_scenario_d4"
                            android:textOn="@string/settings_scenario_d4" />

                        <ToggleButton
                            android:id="@+id/scenarioD5"
                            style="@style/Widget.Pleos.ToggleButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/moca_gap"
                            android:layout_weight="1"
                            android:checked="false"
                            android:background="@drawable/moca_scenario_bg"
                            android:ellipsize="none"
                            android:maxLines="2"
                            android:minHeight="@dimen/pleos_toggle_button_height"
                            android:paddingStart="@dimen/moca_gap_small"
                            android:paddingEnd="@dimen/moca_gap_small"
                            android:textAppearance="@style/Pleos.Text.Label.S"
                            android:textColor="@color/moca_scenario_text"
                            android:textSize="@dimen/pleos_text_label_s"
                            android:textOff="@string/settings_scenario_d5"
                            android:textOn="@string/settings_scenario_d5" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/moca_gap_small"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <ToggleButton
                            android:id="@+id/scenarioD6"
                            style="@style/Widget.Pleos.ToggleButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:checked="false"
                            android:background="@drawable/moca_scenario_bg"
                            android:ellipsize="none"
                            android:maxLines="2"
                            android:minHeight="@dimen/pleos_toggle_button_height"
                            android:paddingStart="@dimen/moca_gap_small"
                            android:paddingEnd="@dimen/moca_gap_small"
                            android:textAppearance="@style/Pleos.Text.Label.S"
                            android:textColor="@color/moca_scenario_text"
                            android:textSize="@dimen/pleos_text_label_s"
                            android:textOff="@string/settings_scenario_d6"
                            android:textOn="@string/settings_scenario_d6" />

                        <ToggleButton
                            android:id="@+id/scenarioD7"
                            style="@style/Widget.Pleos.ToggleButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/moca_gap"
                            android:layout_weight="1"
                            android:checked="false"
                            android:background="@drawable/moca_scenario_bg"
                            android:ellipsize="none"
                            android:maxLines="2"
                            android:minHeight="@dimen/pleos_toggle_button_height"
                            android:paddingStart="@dimen/moca_gap_small"
                            android:paddingEnd="@dimen/moca_gap_small"
                            android:textAppearance="@style/Pleos.Text.Label.S"
                            android:textColor="@color/moca_scenario_text"
                            android:textSize="@dimen/pleos_text_label_s"
                            android:textOff="@string/settings_scenario_d7"
                            android:textOn="@string/settings_scenario_d7" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settingsPanelData"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <Switch
                    android:id="@+id/switchConsent"
                    style="@style/Widget.Pleos.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_consent_1" />

                <Switch
                    android:id="@+id/switchConsentCloud"
                    style="@style/Widget.Pleos.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/moca_gap_small"
                    android:text="@string/onboarding_consent_2" />

                <TextView
                    style="@style/Pleos.Text.Label.S"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/moca_gap"
                    android:text="@string/onboarding_consent_2_hint"
                    android:textColor="@color/pleos_text_dark_secondary" />

                <Switch
                    android:id="@+id/switchConsentBattle"
                    style="@style/Widget.Pleos.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/moca_gap_small"
                    android:text="@string/onboarding_consent_3" />

                <TextView
                    style="@style/Pleos.Text.Label.S"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/moca_gap"
                    android:text="@string/onboarding_consent_3_hint"
                    android:textColor="@color/pleos_text_dark_secondary" />

                <Switch
                    android:id="@+id/switchConsentUsage"
                    style="@style/Widget.Pleos.Switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/moca_gap_small"
                    android:text="@string/onboarding_consent_4" />

                <TextView
                    style="@style/Pleos.Text.Label.S"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/moca_gap"
                    android:text="@string/onboarding_consent_4_hint"
                    android:textColor="@color/pleos_text_dark_secondary" />

                <Button
                    android:id="@+id/buttonDeleteData"
                    style="@style/Widget.Pleos.Button.Primary.M"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/pleos_button_height_m"
                    android:layout_marginTop="@dimen/moca_gap"
                    android:text="@string/settings_delete_data" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Pleos.Text.Label.S"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/moca_gap"
        android:text="@string/c19_disclaimer"
        android:textColor="@color/pleos_text_dark_tertiary" />
</LinearLayout>
