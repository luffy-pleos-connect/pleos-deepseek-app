<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingStart="@dimen/moca_screen_margin"
    android:paddingTop="@dimen/moca_gap"
    android:paddingEnd="@dimen/moca_screen_margin"
    android:paddingBottom="@dimen/moca_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/Pleos.Text.Title.L"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />

        <TextView
            style="@style/Pleos.Text.Body.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap"
            android:text="@string/settings_nickname"
            android:textColor="@color/pleos_text_dark_secondary" />

        <TextView
            android:id="@+id/nicknameValue"
            style="@style/Pleos.Text.Body.M.Strong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap_small"
            android:text="@string/home_grade_placeholder" />

        <Switch
            android:id="@+id/switchDemo"
            style="@style/Widget.Pleos.Switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap"
            android:text="@string/settings_demo" />

        <Switch
            android:id="@+id/switchConsent"
            style="@style/Widget.Pleos.Switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap_small"
            android:text="@string/settings_consent" />

        <Button
            android:id="@+id/buttonDeleteData"
            style="@style/Widget.Pleos.Button.Primary.M"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pleos_button_height_m"
            android:layout_marginTop="@dimen/moca_gap"
            android:text="@string/settings_delete_data" />

        <TextView
            style="@style/Pleos.Text.Label.S"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap"
            android:text="@string/c19_disclaimer"
            android:textColor="@color/pleos_text_dark_tertiary" />
    </LinearLayout>
</ScrollView>
