<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/startContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingStart="@dimen/moca_screen_margin"
        android:paddingTop="@dimen/moca_gap"
        android:paddingEnd="@dimen/moca_screen_margin"
        android:paddingBottom="@dimen/moca_gap">

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Widget.Pleos.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/moca_card_padding">

                <TextView
                    android:id="@+id/startGrade"
                    style="@style/Pleos.Text.Headline.L.Bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_grade_placeholder" />

                <TextView
                    android:id="@+id/startUnmeasured"
                    style="@style/Pleos.Text.Label.M"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/moca_gap_small"
                    android:textColor="@color/pleos_text_dark_tertiary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/startEnergy"
                    style="@style/Pleos.Text.Body.M"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/moca_gap"
                    android:textColor="@color/pleos_text_dark_secondary"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/startWarningsCard"
                style="@style/Widget.Pleos.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap"
                android:orientation="vertical"
                android:padding="@dimen/moca_card_padding">

                <TextView
                    style="@style/Pleos.Text.Label.M"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/start_warnings_title"
                    android:textColor="@color/pleos_text_dark_tertiary" />

                <LinearLayout
                    android:id="@+id/startWarnings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/startWarningsNone"
                    style="@style/Pleos.Text.Body.M"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/moca_gap_small"
                    android:text="@string/start_warnings_none"
                    android:textColor="@color/pleos_text_dark_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/moca_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/startCategories"
                style="@style/Widget.Pleos.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/moca_card_padding"
                android:paddingTop="@dimen/moca_gap_small"
                android:paddingEnd="@dimen/moca_card_padding"
                android:paddingBottom="@dimen/moca_gap_small">

                <TextView
                    style="@style/Pleos.Text.Label.M"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/start_categories_title"
                    android:textColor="@color/pleos_text_dark_tertiary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/moca_category_min_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/startCatPowerName"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_cat_power" />

                    <View
                        android:id="@+id/startCatPowerDot"
                        android:layout_width="@dimen/moca_status_dot"
                        android:layout_height="@dimen/moca_status_dot"
                        android:background="@drawable/moca_status_dot" />

                    <TextView
                        android:id="@+id/startCatPowerStatus"
                        style="@style/Pleos.Text.Body.M"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap_small" />

                    <TextView
                        android:id="@+id/startCatPowerScore"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="@dimen/moca_score_column"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/home_grade_placeholder" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/moca_category_min_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/startCatBrakeName"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_cat_brake" />

                    <View
                        android:id="@+id/startCatBrakeDot"
                        android:layout_width="@dimen/moca_status_dot"
                        android:layout_height="@dimen/moca_status_dot"
                        android:background="@drawable/moca_status_dot" />

                    <TextView
                        android:id="@+id/startCatBrakeStatus"
                        style="@style/Pleos.Text.Body.M"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap_small" />

                    <TextView
                        android:id="@+id/startCatBrakeScore"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="@dimen/moca_score_column"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/home_grade_placeholder" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/moca_category_min_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/startCatTireName"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_cat_tire" />

                    <View
                        android:id="@+id/startCatTireDot"
                        android:layout_width="@dimen/moca_status_dot"
                        android:layout_height="@dimen/moca_status_dot"
                        android:background="@drawable/moca_status_dot" />

                    <TextView
                        android:id="@+id/startCatTireStatus"
                        style="@style/Pleos.Text.Body.M"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap_small" />

                    <TextView
                        android:id="@+id/startCatTireScore"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="@dimen/moca_score_column"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/home_grade_placeholder" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/moca_category_min_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/startCatElectricName"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_cat_electric" />

                    <View
                        android:id="@+id/startCatElectricDot"
                        android:layout_width="@dimen/moca_status_dot"
                        android:layout_height="@dimen/moca_status_dot"
                        android:background="@drawable/moca_status_dot" />

                    <TextView
                        android:id="@+id/startCatElectricStatus"
                        style="@style/Pleos.Text.Body.M"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap_small" />

                    <TextView
                        android:id="@+id/startCatElectricScore"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="@dimen/moca_score_column"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/home_grade_placeholder" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/moca_category_min_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/startCatSafetyName"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_cat_safety" />

                    <View
                        android:id="@+id/startCatSafetyDot"
                        android:layout_width="@dimen/moca_status_dot"
                        android:layout_height="@dimen/moca_status_dot"
                        android:background="@drawable/moca_status_dot" />

                    <TextView
                        android:id="@+id/startCatSafetyStatus"
                        style="@style/Pleos.Text.Body.M"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap_small" />

                    <TextView
                        android:id="@+id/startCatSafetyScore"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="@dimen/moca_score_column"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="@string/home_grade_placeholder" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/startActionsCard"
                style="@style/Widget.Pleos.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap"
                android:orientation="vertical"
                android:padding="@dimen/moca_card_padding">

                <TextView
                    style="@style/Pleos.Text.Label.M"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/start_actions_title"
                    android:textColor="@color/pleos_text_dark_tertiary" />

                <LinearLayout
                    android:id="@+id/startActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/startAction1"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/moca_gap_small"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/startAction2"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/moca_gap_small"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/startAction3"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/moca_gap_small"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/startActionsNone"
                        style="@style/Pleos.Text.Body.M"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/moca_gap_small"
                        android:text="@string/start_actions_none"
                        android:textColor="@color/pleos_text_dark_secondary"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/startGoRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/moca_gap"
        android:orientation="vertical">

        <TextView
            android:id="@+id/startAutoHint"
            style="@style/Pleos.Text.Body.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/moca_gap_small"
            android:textColor="@color/pleos_text_dark_secondary"
            android:visibility="gone" />

        <Button
            android:id="@+id/startGoMain"
            style="@style/Widget.Pleos.Button.Secondary.L"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/start_go_main" />
    </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/startLoading"
        style="@style/Pleos.Text.Title.M"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/start_loading"
        android:textColor="@color/pleos_text_dark_secondary" />
</FrameLayout>
