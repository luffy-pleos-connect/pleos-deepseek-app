<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/moca_screen_margin"
    android:paddingTop="@dimen/moca_gap"
    android:paddingEnd="@dimen/moca_screen_margin"
    android:paddingBottom="@dimen/moca_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/Widget.Pleos.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/moca_card_padding">

            <TextView
                style="@style/Pleos.Text.Title.L"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_title" />

            <LinearLayout
                android:id="@+id/onboardFeature1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/moca_cat_icon"
                    android:layout_height="@dimen/moca_cat_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cat_power"
                    android:tint="@color/pleos_text_dark_primary" />

                <TextView
                    style="@style/Pleos.Text.Title.S"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/moca_gap"
                    android:layout_weight="1"
                    android:text="@string/onboarding_feature_1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/onboardFeature2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/moca_cat_icon"
                    android:layout_height="@dimen/moca_cat_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/pleos_ic_alert" />

                <TextView
                    style="@style/Pleos.Text.Title.S"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/moca_gap"
                    android:layout_weight="1"
                    android:text="@string/onboarding_feature_2" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/onboardFeature3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/moca_cat_icon"
                    android:layout_height="@dimen/moca_cat_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cat_safety"
                    android:tint="@color/pleos_text_dark_primary" />

                <TextView
                    style="@style/Pleos.Text.Title.S"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/moca_gap"
                    android:layout_weight="1"
                    android:text="@string/onboarding_feature_3" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.Pleos.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/moca_gap"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/moca_card_padding">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <CheckBox
                        android:id="@+id/consent1"
                        style="@style/Widget.Pleos.CheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/onboarding_consent_1" />

                    <CheckBox
                        android:id="@+id/consent2"
                        style="@style/Widget.Pleos.CheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_consent_2" />

                    <TextView
                        android:id="@+id/consent2Hint"
                        style="@style/Pleos.Text.Label.S"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap"
                        android:text="@string/onboarding_consent_2_hint"
                        android:textColor="@color/pleos_text_dark_secondary" />

                    <CheckBox
                        android:id="@+id/consent3"
                        style="@style/Widget.Pleos.CheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_consent_3" />

                    <TextView
                        android:id="@+id/consent3Hint"
                        style="@style/Pleos.Text.Label.S"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap"
                        android:text="@string/onboarding_consent_3_hint"
                        android:textColor="@color/pleos_text_dark_secondary" />

                    <CheckBox
                        android:id="@+id/consent4"
                        style="@style/Widget.Pleos.CheckBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_consent_4" />

                    <TextView
                        android:id="@+id/consent4Hint"
                        style="@style/Pleos.Text.Label.S"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap"
                        android:text="@string/onboarding_consent_4_hint"
                        android:textColor="@color/pleos_text_dark_secondary" />

                    <EditText
                        android:id="@+id/nicknameInput"
                        style="@style/Widget.Pleos.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/pleos_button_height_l"
                        android:layout_marginTop="@dimen/moca_gap_small"
                        android:hint="@string/onboarding_nickname"
                        android:imeOptions="flagNoExtractUi|actionDone"
                        android:inputType="text"
                        android:maxLength="10" />

                    <Button
                        android:id="@+id/buttonStart"
                        style="@style/Widget.Pleos.Button.Secondary.M"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/pleos_button_height_m"
                        android:layout_marginTop="@dimen/moca_gap_small"
                        android:text="@string/onboarding_agree" />

                    <Button
                        android:id="@+id/buttonSkip"
                        style="@style/Widget.Pleos.Button.Primary.S"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/pleos_button_height_s"
                        android:layout_marginTop="@dimen/moca_gap_small"
                        android:text="@string/onboarding_skip" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Pleos.Text.Label.S"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/moca_gap"
        android:text="@string/c19_disclaimer"
        android:textColor="@color/pleos_text_dark_tertiary" />
</LinearLayout>
