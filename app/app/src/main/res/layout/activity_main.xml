<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pleos_background_primary"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/moca_screen_margin"
        android:paddingTop="@dimen/moca_gap"
        android:paddingEnd="@dimen/moca_screen_margin">

        <TextView
            android:id="@+id/headerTitle"
            style="@style/Pleos.Text.Title.L"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:text="@string/app_name" />
    </FrameLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <RadioGroup
        android:id="@+id/tabBar"
        style="@style/Widget.Pleos.Segmented"
        android:layout_width="match_parent"
        android:layout_marginStart="@dimen/moca_screen_margin"
        android:layout_marginTop="@dimen/moca_gap_small"
        android:layout_marginEnd="@dimen/moca_screen_margin"
        android:layout_marginBottom="@dimen/moca_gap"
        android:checkedButton="@+id/tabHome">

        <RadioButton
            android:id="@+id/tabHome"
            style="@style/Widget.Pleos.Segmented.Item"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/nav_home" />

        <RadioButton
            android:id="@+id/tabStatus"
            style="@style/Widget.Pleos.Segmented.Item"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/nav_status" />

        <RadioButton
            android:id="@+id/tabVoice"
            style="@style/Widget.Pleos.Segmented.Item"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/nav_voice" />

        <RadioButton
            android:id="@+id/tabBattle"
            style="@style/Widget.Pleos.Segmented.Item"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/nav_battle" />

        <RadioButton
            android:id="@+id/tabSettings"
            style="@style/Widget.Pleos.Segmented.Item"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/nav_settings" />
    </RadioGroup>
</LinearLayout>
