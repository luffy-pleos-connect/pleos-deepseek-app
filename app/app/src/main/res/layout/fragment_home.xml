<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/moca_screen_margin"
    android:paddingTop="@dimen/moca_gap"
    android:paddingEnd="@dimen/moca_screen_margin"
    android:paddingBottom="@dimen/moca_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/Widget.Pleos.Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/moca_card_padding">

            <TextView
                android:id="@+id/gradeUpBanner"
                style="@style/Pleos.Text.Title.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/moca_gap"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/pleos_informative_positive"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="@dimen/moca_score_ring"
                android:layout_height="@dimen/moca_score_ring">

                <ai.moca.app.ui.widget.ScoreRingView
                    android:id="@+id/scoreRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/gradeValue"
                        style="@style/Pleos.Text.Headline.L.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_grade_placeholder" />

                    <TextView
                        android:id="@+id/totalValue"
                        style="@style/Pleos.Text.Title.M"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/moca_gap_small"
                        android:text="@string/home_grade_placeholder" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/gradeHint"
                style="@style/Pleos.Text.Title.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap"
                android:gravity="center"
                android:text="@string/c03_first_grade"
                android:textColor="@color/pleos_text_dark_secondary" />

            <TextView
                android:id="@+id/rankText"
                style="@style/Pleos.Text.Title.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap_small"
                android:gravity="center"
                android:textColor="@color/pleos_text_dark_secondary"
                android:visibility="gone" />

            <!-- 덜 급한 값(건강, 관리, 마지막 점검일)은 작은 글자로 한 줄에 모은다. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/healthValue"
                    style="@style/Pleos.Text.Label.M"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_grade_placeholder"
                    android:textColor="@color/pleos_text_dark_tertiary" />

                <TextView
                    android:id="@+id/careValue"
                    style="@style/Pleos.Text.Label.M"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/moca_gap"
                    android:text="@string/home_grade_placeholder"
                    android:textColor="@color/pleos_text_dark_tertiary" />

                <TextView
                    android:id="@+id/lastInspection"
                    style="@style/Pleos.Text.Label.M"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/moca_gap"
                    android:text="@string/home_never_inspected"
                    android:textColor="@color/pleos_text_dark_tertiary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/moca_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/topProblemCard"
                style="@style/Widget.Pleos.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/moca_card_padding">

                <TextView
                    style="@style/Pleos.Text.Label.M"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_top_title"
                    android:textColor="@color/pleos_text_dark_tertiary" />

                <TextView
                    android:id="@+id/topProblemText"
                    style="@style/Pleos.Text.Title.L"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/moca_gap_small"
                    android:text="@string/home_grade_placeholder" />

                <!-- 켜진 경고등 수. 문제와 같은 칸에 둔다. 없으면 숨긴다. -->
                <TextView
                    android:id="@+id/warningSummary"
                    style="@style/Pleos.Text.Label.M"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/moca_gap_small"
                    android:textColor="@color/pleos_text_dark_secondary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/homeStreak"
                    style="@style/Pleos.Text.Label.M"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/moca_gap_small"
                    android:textColor="@color/pleos_text_dark_secondary"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/topProblemAction"
                    style="@style/Widget.Pleos.Button.Secondary.L"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/moca_gap"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/categoryList"
                style="@style/Widget.Pleos.Card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/moca_gap"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/moca_card_padding"
                android:paddingTop="@dimen/moca_gap_small"
                android:paddingEnd="@dimen/moca_card_padding"
                android:paddingBottom="@dimen/moca_gap_small">

                <LinearLayout
                    android:id="@+id/catPower"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/moca_category_min_height"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/moca_cat_icon"
                        android:layout_height="@dimen/moca_cat_icon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_cat_power"
                        android:tint="@color/pleos_text_dark_primary" />

                    <TextView
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap_small"
                        android:layout_weight="1"
                        android:text="@string/home_cat_power" />

                    <View
                        android:id="@+id/catPowerDot"
                        android:layout_width="@dimen/moca_status_dot"
                        android:layout_height="@dimen/moca_status_dot"
                        android:background="@drawable/moca_status_dot" />

                    <TextView
                        android:id="@+id/catPowerStatus"
                        style="@style/Pleos.Text.Body.L"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap_small"
                        android:text="@string/c06_unmeasurable" />

                    <TextView
                        android:id="@+id/catPowerScore"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap"
                        android:text="@string/home_grade_placeholder" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/catBrake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/moca_category_min_height"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/moca_cat_icon"
                        android:layout_height="@dimen/moca_cat_icon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_cat_brake"
                        android:tint="@color/pleos_text_dark_primary" />

                    <TextView
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap_small"
                        android:layout_weight="1"
                        android:text="@string/home_cat_brake" />

                    <View
                        android:id="@+id/catBrakeDot"
                        android:layout_width="@dimen/moca_status_dot"
                        android:layout_height="@dimen/moca_status_dot"
                        android:background="@drawable/moca_status_dot" />

                    <TextView
                        android:id="@+id/catBrakeStatus"
                        style="@style/Pleos.Text.Body.L"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap_small"
                        android:text="@string/c06_unmeasurable" />

                    <TextView
                        android:id="@+id/catBrakeScore"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap"
                        android:text="@string/home_grade_placeholder" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/catTire"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/moca_category_min_height"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/moca_cat_icon"
                        android:layout_height="@dimen/moca_cat_icon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_cat_tire"
                        android:tint="@color/pleos_text_dark_primary" />

                    <TextView
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap_small"
                        android:layout_weight="1"
                        android:text="@string/home_cat_tire" />

                    <View
                        android:id="@+id/catTireDot"
                        android:layout_width="@dimen/moca_status_dot"
                        android:layout_height="@dimen/moca_status_dot"
                        android:background="@drawable/moca_status_dot" />

                    <TextView
                        android:id="@+id/catTireStatus"
                        style="@style/Pleos.Text.Body.L"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap_small"
                        android:text="@string/c06_unmeasurable" />

                    <TextView
                        android:id="@+id/catTireScore"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap"
                        android:text="@string/home_grade_placeholder" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/catElectric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/moca_category_min_height"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/moca_cat_icon"
                        android:layout_height="@dimen/moca_cat_icon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_cat_electric"
                        android:tint="@color/pleos_text_dark_primary" />

                    <TextView
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap_small"
                        android:layout_weight="1"
                        android:text="@string/home_cat_electric" />

                    <View
                        android:id="@+id/catElectricDot"
                        android:layout_width="@dimen/moca_status_dot"
                        android:layout_height="@dimen/moca_status_dot"
                        android:background="@drawable/moca_status_dot" />

                    <TextView
                        android:id="@+id/catElectricStatus"
                        style="@style/Pleos.Text.Body.L"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap_small"
                        android:text="@string/c06_unmeasurable" />

                    <TextView
                        android:id="@+id/catElectricScore"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap"
                        android:text="@string/home_grade_placeholder" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/catSafety"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/moca_category_min_height"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/moca_cat_icon"
                        android:layout_height="@dimen/moca_cat_icon"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_cat_safety"
                        android:tint="@color/pleos_text_dark_primary" />

                    <TextView
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap_small"
                        android:layout_weight="1"
                        android:text="@string/home_cat_safety" />

                    <View
                        android:id="@+id/catSafetyDot"
                        android:layout_width="@dimen/moca_status_dot"
                        android:layout_height="@dimen/moca_status_dot"
                        android:background="@drawable/moca_status_dot" />

                    <TextView
                        android:id="@+id/catSafetyStatus"
                        style="@style/Pleos.Text.Body.L"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap_small"
                        android:text="@string/c06_unmeasurable" />

                    <TextView
                        android:id="@+id/catSafetyScore"
                        style="@style/Pleos.Text.Title.S"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/moca_gap"
                        android:text="@string/home_grade_placeholder" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/disclaimer"
        style="@style/Pleos.Text.Label.S"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/moca_gap"
        android:text="@string/c19_disclaimer"
        android:textColor="@color/pleos_text_dark_tertiary" />
</LinearLayout>
