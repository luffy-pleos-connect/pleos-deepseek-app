<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="@dimen/moca_screen_margin"
    android:paddingTop="@dimen/moca_gap"
    android:paddingEnd="@dimen/moca_screen_margin"
    android:paddingBottom="@dimen/moca_gap">

    <!-- 좌: 상태 + 마이크 + 글자 입력 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/moca_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/badgeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/voiceOfflineBadge"
                style="@style/Pleos.Text.Label.M"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/moca_gap_small"
                android:text="@string/voice_badge_offline"
                android:textColor="@color/pleos_text_dark_tertiary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/voiceDemoBadge"
                style="@style/Pleos.Text.Label.M"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voice_badge_demo"
                android:textColor="@color/pleos_text_dark_secondary"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/voiceState"
            style="@style/Pleos.Text.Title.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap_small"
            android:text="@string/voice_state_idle" />

        <Button
            android:id="@+id/micButton"
            style="@style/Widget.Pleos.Button.Secondary.L"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pleos_button_height_l"
            android:layout_marginTop="@dimen/moca_gap"
            android:text="@string/c09_ask_by_voice" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/questionInput"
                style="@style/Widget.Pleos.TextField"
                android:layout_width="0dp"
                android:layout_height="@dimen/pleos_button_height_l"
                android:layout_marginEnd="@dimen/moca_gap_small"
                android:layout_weight="1"
                android:hint="@string/voice_hint_type"
                android:inputType="text"
                android:maxLength="100" />

            <Button
                android:id="@+id/sendButton"
                style="@style/Widget.Pleos.Button.Primary.M"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/pleos_button_height_l"
                android:text="@string/voice_send" />
        </LinearLayout>

        <TextView
            android:id="@+id/toolChips"
            style="@style/Pleos.Text.Label.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap"
            android:textColor="@color/pleos_text_dark_tertiary" />

        <TextView
            style="@style/Pleos.Text.Label.S"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/c19_disclaimer"
            android:textColor="@color/pleos_text_dark_tertiary"
            android:gravity="bottom" />
    </LinearLayout>

    <!-- 우: 답 + 추천 질문 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/answerText"
            style="@style/Pleos.Text.Body.L"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/voice_state_idle"
            android:textColor="@color/pleos_text_dark_primary" />

        <Button
            android:id="@+id/suggestion1"
            style="@style/Widget.Pleos.Button.Primary.S"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pleos_button_height_s"
            android:layout_marginTop="@dimen/moca_gap_small"
            android:text="@string/voice_recent_1" />

        <Button
            android:id="@+id/suggestion2"
            style="@style/Widget.Pleos.Button.Primary.S"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pleos_button_height_s"
            android:layout_marginTop="@dimen/moca_gap_small"
            android:text="@string/voice_recent_2" />

        <Button
            android:id="@+id/suggestion3"
            style="@style/Widget.Pleos.Button.Primary.S"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pleos_button_height_s"
            android:layout_marginTop="@dimen/moca_gap_small"
            android:text="@string/voice_recent_3" />

        <Button
            android:id="@+id/suggestion4"
            style="@style/Widget.Pleos.Button.Primary.S"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pleos_button_height_s"
            android:layout_marginTop="@dimen/moca_gap_small"
            android:text="@string/voice_recent_4" />
    </LinearLayout>
</LinearLayout>
