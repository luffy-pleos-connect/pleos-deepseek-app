<?xml version="1.0" encoding="utf-8"?>
<!-- 좁은(세로) 창: 배너를 세로로 풀고 타일을 2×2로 접는다.
     P1(등급·주의)과 주 동작(타일 4개)은 남기고, 종합·건강·관리 수치는 숨긴다(P2). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingStart="@dimen/moca_screen_margin"
    android:paddingTop="@dimen/moca_gap"
    android:paddingEnd="@dimen/moca_screen_margin"
    android:paddingBottom="@dimen/moca_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            style="@style/Widget.Pleos.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/moca_card_padding">

            <TextView
                style="@style/Pleos.Text.Label.M"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_title"
                android:textColor="@color/pleos_text_dark_tertiary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gradeValue"
                    style="@style/Pleos.Text.Headline.L"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_grade_placeholder" />

                <TextView
                    android:id="@+id/warningSummary"
                    style="@style/Pleos.Text.Title.M"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/home_warning_none"
                    android:textColor="@color/pleos_text_dark_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/gradeHint"
                style="@style/Pleos.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap_small"
                android:text="@string/c03_first_grade"
                android:textColor="@color/pleos_text_dark_secondary" />

            <TextView
                android:id="@+id/lastInspection"
                style="@style/Pleos.Text.Label.S"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap_small"
                android:text="@string/home_never_inspected"
                android:textColor="@color/pleos_text_dark_tertiary" />

            <!-- P2: 세로 창에서는 숨긴다. 코드가 참조하므로 View 는 유지. -->
            <TextView
                android:id="@+id/totalValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/healthValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/careValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tileInspect"
                style="@style/Widget.Pleos.Card"
                android:layout_width="0dp"
                android:layout_height="@dimen/moca_tile_min_height"
                android:layout_marginEnd="@dimen/moca_gap"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="@dimen/moca_gap">

                <TextView
                    style="@style/Pleos.Text.Title.S"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_inspect" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileStatus"
                style="@style/Widget.Pleos.Card"
                android:layout_width="0dp"
                android:layout_height="@dimen/moca_tile_min_height"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="@dimen/moca_gap">

                <TextView
                    style="@style/Pleos.Text.Title.S"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_status" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tileVoice"
                style="@style/Widget.Pleos.Card"
                android:layout_width="0dp"
                android:layout_height="@dimen/moca_tile_min_height"
                android:layout_marginEnd="@dimen/moca_gap"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="@dimen/moca_gap">

                <TextView
                    style="@style/Pleos.Text.Title.S"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_voice" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileBattle"
                style="@style/Widget.Pleos.Card"
                android:layout_width="0dp"
                android:layout_height="@dimen/moca_tile_min_height"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="@dimen/moca_gap">

                <TextView
                    style="@style/Pleos.Text.Title.S"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_battle" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
