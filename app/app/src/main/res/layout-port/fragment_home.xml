<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/moca_screen_margin"
        android:paddingTop="@dimen/moca_gap"
        android:paddingEnd="@dimen/moca_screen_margin"
        android:paddingBottom="@dimen/moca_gap">

        <TextView
            android:id="@+id/mainGrade"
            style="@style/Pleos.Text.Title.L"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_grade_placeholder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap_small"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mainBadge"
                style="@style/Pleos.Text.Body.L"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_warning_none" />

            <TextView
                android:id="@+id/mainAgo"
                style="@style/Pleos.Text.Label.M"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pleos_text_dark_tertiary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeNoGradeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/homeNoGrade"
                style="@style/Pleos.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/c20_not_enough_data"
                android:textColor="@color/pleos_text_dark_secondary" />

            <Button
                android:id="@+id/homeDemoAction"
                style="@style/Widget.Pleos.Button.Primary.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap_small"
                android:text="@string/home_demo_action" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonStatus"
            style="@style/Widget.Pleos.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="@dimen/moca_home_tile_min_height"
            android:orientation="vertical"
            android:padding="@dimen/moca_card_padding">

            <TextView
                style="@style/Pleos.Text.Title.L"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_button_status" />

            <TextView
                style="@style/Pleos.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap_small"
                android:text="@string/main_button_status_hint"
                android:textColor="@color/pleos_text_dark_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonVoice"
            style="@style/Widget.Pleos.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="@dimen/moca_home_tile_min_height"
            android:orientation="vertical"
            android:padding="@dimen/moca_card_padding">

            <TextView
                style="@style/Pleos.Text.Title.L"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_button_voice" />

            <TextView
                style="@style/Pleos.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap_small"
                android:text="@string/main_button_voice_hint"
                android:textColor="@color/pleos_text_dark_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonBattle"
            style="@style/Widget.Pleos.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/moca_gap"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="@dimen/moca_home_tile_min_height"
            android:orientation="vertical"
            android:padding="@dimen/moca_card_padding">

            <TextView
                style="@style/Pleos.Text.Title.L"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_button_battle" />

            <TextView
                style="@style/Pleos.Text.Body.M"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/moca_gap_small"
                android:text="@string/main_button_battle_hint"
                android:textColor="@color/pleos_text_dark_secondary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
