<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- G0: 읽기 전용 차량 데이터 권한만. CONTROL_ 권한은 쓰지 않는다.
         출처: Vehicle-2.3.2.aar 의 PleosPermission 상수 + 각 api 클래스(@RequiresPermission) -->
    <!-- getTelltalesInfo/registerTelltales 는 문서상 PRIVATE_CAR_SAFETY (signature|privileged).
         에뮬레이터에서는 protectionLevel=normal 로 선언되어 있어 G0에서 실제 수신 여부를 시험한다. -->
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />

    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
